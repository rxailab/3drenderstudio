 "adaptation_rules": [
  "auto mode: hull/slender-diagonal or tall (aspect<0.8) -> free-slot placement; otherwise band rows",
  "band: anchors in upper half -> row above, lower half -> row below, balanced to ceil(n/2) per row",
  "band: <=2 labels on the same side -> single row (product keeps height); label width 560 when <=2 per row else 420",
  "label x snapped to a shared column grid aligned with the headline edge",
  "free-slot: all placement orders tried; rejects slots touching the product hull (28px pad), headline, other labels, or leaders crossing labels/leaders",
  "max 4 labels; more -> split image (no font shrinking)",
  "headline: max 2 lines, one defined long-headline step (100->80px), then QA fail",
  "zh copy may carry \\n at approved phrase boundaries"
 ],
