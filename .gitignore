data/
__pycache__/
.env
# ai_config writes the new .env through Path('.env').with_suffix('.env.tmp'), which is '.env.env.tmp'
.env.env.tmp
*.log
# rotated application logs (app_log.py) wherever STUDIO_DATA puts the data folder
studio.log.*
logs/
# Blender's automatic backup of a saved .blend
*.blend1
.venv/
.venv-depth/
node_modules/
brandkit/vendor/
# material library: no HDRI/EXR sources in git (the 319 MB pack stays outside)
materials/**/*.exr
materials/**/*.hdr

# Local KeyShot photographs and imported lighting. Procedural defaults live in builtin/.
/static/studio-backdrops/catalog.json
/static/studio-backdrops/images/
/static/studio-backdrops/thumbs/
/static/studio-backdrops/radiance/
/static/studio-backdrops/environments/

# Local material images are installed from the user's KeyShot library.
/KeyShot提取/
/materials/keyshot/previews/
/materials/keyshot/textures/
/materials/keyshot/viewport-textures/
